---
import BaseLayout from '@/layouts/BaseLayout.astro';

const pages = [
  {
    href: '/',
    name: 'Home',
    description:
      'The AstroDeck homepage: centered hero with a copyable starter prompt, tech logo cloud, supported-agents grid, kit stats from the registry, feature grid, FAQ and CTA.',
    screenshot: '/screenshots/home.png',
    category: 'Landing Page',
  },
  {
    href: '/templates/saas',
    name: 'SaaS Landing',
    description:
      'SaaS landing page for Nebula, a fictional product, in the order of the SaaS recipe: split hero, logo cloud, features, content block, integrations, testimonials, pricing, FAQ and CTA.',
    screenshot: '/screenshots/saas.png',
    category: 'Landing Page',
  },
  {
    href: '/templates/portfolio',
    name: 'Portfolio / Agency',
    description:
      'Agency page for Acme Studio, a fictional studio: split hero, client logos, stats, alternating content blocks, team, testimonials, newsletter signup and CTA.',
    screenshot: '/screenshots/portfolio.png',
    category: 'Landing Page',
  },
  {
    href: '/templates/startup',
    name: 'Startup / Product Launch',
    description:
      'Product launch page: gradient hero, feature grid, comparison table, content deep-dive, stats, testimonials, FAQ and CTA.',
    screenshot: '/screenshots/startup.png',
    category: 'Landing Page',
  },
  {
    href: '/templates/contact',
    name: 'Contact & About',
    description: 'Contact section with form, email, phone and address, followed by support FAQs.',
    screenshot: '/screenshots/contact.png',
    category: 'Utility Page',
  },
  {
    href: '/blog',
    name: 'Blog',
    description:
      'Blog listing with pagination, tag filtering, and content collection integration. Includes RSS feed and archive page.',
    screenshot: '/screenshots/blog.png',
    category: 'Content Page',
  },
  {
    href: '/docs',
    name: 'Documentation',
    description:
      'Documentation with sidebar navigation: getting started, the build-site workflow, site config, theme, cleanup, verify, vibe2prod, supported agents and migrating from 3.x.',
    screenshot: '/screenshots/docs.png',
    category: 'Content Page',
  },
  {
    href: '/login',
    name: 'Login',
    description:
      'Split-screen authentication layout with dark branding panel, testimonial quote, and centered login form with social auth.',
    screenshot: '/screenshots/login.png',
    category: 'Utility Page',
  },
  {
    href: '/sections',
    name: 'Sections Showcase',
    description:
      'Section library: the registry usage snippet for each section and layout ideas built with the same tokens.',
    screenshot: '/screenshots/sections.png',
    category: 'Content Page',
  },
  {
    href: '/changelog',
    name: 'Changelog',
    description:
      'Release history timeline with version badges, dates, and categorized changes. Pulse animation on the latest entry.',
    screenshot: '/screenshots/changelog.png',
    category: 'Content Page',
  },
  {
    href: '/content',
    name: 'Content Demo',
    description:
      'Typography and content formatting demo page showing prose styles, headings, lists, code blocks, and rich text rendering.',
    screenshot: '/screenshots/content.png',
    category: 'Content Page',
  },
];

const categories = [...new Set(pages.map((p) => p.category))];
---

<BaseLayout
  title="Pages"
  description="Every page of the AstroDeck demo: landing pages, content pages and utility pages, built from the same sections and layouts as your site."
>
  <div class="py-16 md:py-20 px-6">
    <div class="container max-w-5xl mx-auto">
      <div class="mb-12" data-animate="fade">
        <h1 class="text-4xl font-bold tracking-tight md:text-5xl">Pages</h1>
        <p class="mt-4 text-lg text-muted-foreground max-w-2xl leading-relaxed">
          Every page of the AstroDeck demo, from landing pages to utility screens: responsive, in
          light and dark mode, built from the same sections and layouts as your site. The demo pages
          are worked examples; <code class="text-sm font-mono">npm run starter:clean</code>
          removes them when you build your own site.
        </p>
      </div>

      {
        categories.map((category) => (
          <div class="mb-16">
            <h2
              class="text-sm font-semibold uppercase tracking-wider text-muted-foreground mb-6"
              data-animate
            >
              {category}s
            </h2>
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {pages
                .filter((p) => p.category === category)
                .map((page, i) => (
                  <a
                    href={page.href}
                    class="group flex flex-col rounded-xl border bg-card overflow-hidden transition-all duration-200 hover:shadow-lg hover:-translate-y-0.5 hover:border-primary/40"
                    data-animate
                    data-delay={String(Math.min(i + 1, 5))}
                  >
                    <div class="relative aspect-video overflow-hidden bg-muted border-b">
                      <img
                        src={page.screenshot}
                        alt={`${page.name} page preview`}
                        width="640"
                        height="360"
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
                      />
                    </div>

                    <div class="p-5 flex flex-col flex-1">
                      <div class="flex items-center justify-between mb-2">
                        <h3 class="font-semibold text-base group-hover:text-primary transition-colors">
                          {page.name}
                        </h3>
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="h-4 w-4 text-muted-foreground transition-transform group-hover:translate-x-0.5 group-hover:text-primary"
                          aria-hidden="true"
                        >
                          <path d="M5 12h14M12 5l7 7-7 7" />
                        </svg>
                      </div>
                      <p class="text-sm text-muted-foreground leading-relaxed">
                        {page.description}
                      </p>
                    </div>
                  </a>
                ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</BaseLayout>
