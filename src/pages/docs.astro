---
import FullWidthLayout from '@/layouts/FullWidthLayout.astro';
import CodeBlock from '@/components/demos/CodeBlock.astro';
import { kitStats, recipes, skills, vibe2prodVersion } from '@/components/demos/kit-stats';

const repo = 'https://github.com/holger1411/astrodeck';
const ic = 'text-xs font-mono bg-muted px-1.5 py-0.5 rounded';
const pre = 'bg-muted/50 border border-border rounded-xl p-4 overflow-x-auto';
const card = 'border rounded-xl p-6 bg-card';
const link = 'text-primary underline underline-offset-4 hover:no-underline';

const sections = [
  { id: 'getting-started', label: 'Getting Started' },
  { id: 'workflow', label: 'Build-Site Workflow' },
  { id: 'brief', label: 'Brief & PROJECT.md' },
  { id: 'site-config', label: 'Site Config' },
  { id: 'theme', label: 'Theme & Branding' },
  { id: 'building-blocks', label: 'Sections & Pages' },
  { id: 'cleanup', label: 'Demo Cleanup' },
  { id: 'verify', label: 'Verify' },
  { id: 'vibe2prod', label: 'vibe2prod Audit' },
  { id: 'agents', label: 'Supported Agents' },
  { id: 'mcp', label: 'MCP Servers' },
  { id: 'deploy', label: 'Build & Deploy' },
  { id: 'astro-7', label: 'Astro 7 Notes' },
  { id: 'migrating', label: 'Migrating from 3.x' },
  { id: 'multilingual', label: 'Multilingual Sites' },
  { id: 'project-structure', label: 'Project Structure' },
];

const workflow: { title: string; text: string; cmd?: string }[] = [
  {
    title: 'Intake',
    text: 'The agent inventories your messages, PROJECT.md and brief/. Little input: one message with at most five questions, each with a proposed default. A full briefing: it extracts faithfully, notes sources and lists conflicts and gaps instead of inventing.',
  },
  {
    title: 'Start clean',
    text: 'The astrodeck-cleanup skill removes the demo before anything is written, after showing the plan.',
    cmd: 'npm run starter:clean -- --dry-run',
  },
  {
    title: 'Brief and site plan',
    text: `PROJECT.md is filled, a recipe is chosen (${recipes.join(', ')}) and each page gets a section list from the registry.`,
  },
  {
    title: 'Configure',
    text: 'src/config/site.ts and SITE_URL from the brief; robots.txt, llms.txt and favicons for the real domain and logo.',
  },
  {
    title: 'Theme',
    text: 'Brand colors, neutral tone and radius as OKLCH tokens with a contrast gate; fonts only on brand input.',
    cmd: 'npm run theme -- --primary "<hex>" --dry-run',
  },
  {
    title: 'Build pages',
    text: 'Home first with an early preview, then the rest, composed from sections in the recipe order. Facts come only from the brief.',
    cmd: 'npm run dev',
  },
  {
    title: 'Verify and audit',
    text: 'All checks pass, then the vibe2prod audit targets READY, then the manual items of the quality checklist.',
    cmd: 'npm run verify -- --starter',
  },
  {
    title: 'Handover',
    text: 'What was built, the defaults it chose, open questions (logo, photos, legal pages, form endpoints, URL), check results and how to deploy.',
  },
];

const skillRoutes = [
  { task: 'A website, or "adapt AstroDeck to my project"', skill: 'astrodeck-build-site' },
  { task: 'A new page', skill: 'astrodeck-new-page' },
  { task: 'A section no registry section covers, or a new prop', skill: 'astrodeck-new-section' },
  { task: 'Colors, fonts, radius, logo, DESIGN.md', skill: 'astrodeck-theme' },
  { task: 'Remove the demo', skill: 'astrodeck-cleanup' },
  { task: 'An audit or launch check', skill: 'vibe2prod' },
];

const configFields = [
  { field: 'name, description', use: 'Header, footer, meta tags, manifest' },
  { field: 'url', use: 'SITE_URL: canonical URLs, sitemap, RSS' },
  { field: 'lang, locale', use: '<html lang>, Open Graph locale, RSS language' },
  { field: 'titleTemplate', use: 'Page titles, e.g. "%s | Harbor Physio"' },
  { field: 'author', use: 'Meta author, default blog author' },
  { field: 'logo', use: 'Wordmark text, inline SVG or image' },
  { field: 'nav, headerCta', use: 'Header navigation and button' },
  { field: 'footer', use: 'Tagline, link groups, copyright, optional credit' },
  { field: 'social, contact', use: 'Footer profiles and contact data (real data only)' },
  { field: 'ogImage', use: 'Default social preview image' },
  { field: 'features', use: 'blog, rss, analytics on or off' },
];

const blocks = [
  {
    name: 'Sections',
    count: kitStats.sections,
    path: 'src/components/sections/',
    href: '/sections',
  },
  { name: 'UI components', count: kitStats.ui, path: 'src/components/ui/', href: '/components' },
  { name: 'Layouts', count: kitStats.layouts, path: 'src/layouts/', href: '/pages' },
];

const verifySteps = [
  { id: 'format', what: 'Prettier' },
  { id: 'eslint', what: 'ESLint' },
  { id: 'astro-check', what: 'Types and templates (astro check)' },
  { id: 'lint-design', what: 'Design rules: tokens, links, forms, deprecated APIs' },
  { id: 'lint-docs', what: 'Dead paths, version and count drift in docs, skill front matter' },
  { id: 'registry', what: 'Registry matches component files, props, page templates and recipes' },
  { id: 'agents-sync', what: '.claude/skills mirrors .agents/skills' },
  { id: 'test', what: 'Script tests (node --test)' },
  { id: 'build', what: 'Production build' },
  {
    id: 'dist',
    what: 'Built HTML: one h1, unique titles, meta descriptions, internal links, alt text',
  },
];

const agentRows = [
  {
    name: 'Claude Code',
    agentsMd: 'via CLAUDE.md (@AGENTS.md import)',
    skills: '.claude/skills/ (mirror)',
    status: 'documented',
  },
  {
    name: 'OpenAI Codex',
    agentsMd: 'natively',
    skills: '.agents/skills/',
    status: 'documented',
  },
  {
    name: 'Cursor',
    agentsMd: 'natively',
    skills: '.agents/skills/',
    status: 'documented',
  },
  {
    name: 'GitHub Copilot',
    agentsMd: 'natively (+ .github/copilot-instructions.md pointer)',
    skills: '.agents/skills/, .claude/skills/',
    status: 'documented',
  },
  {
    name: 'Gemini CLI',
    agentsMd: 'via .gemini/settings.json',
    skills: '.agents/skills/',
    status: 'documented',
  },
  {
    name: 'Windsurf (Devin Local)',
    agentsMd: 'natively',
    skills: '.agents/skills/',
    status: 'documented',
  },
];

const astroNotes = [
  'Agents start <code>npm run dev</code> in the background and poll <code>/_astro/status</code> until it returns <code>{"ok":true}</code>.',
  'The compiler is stricter: unclosed or misnested tags fail the build.',
  "<code>compressHTML</code> defaults to <code>'jsx'</code>: whitespace between elements is removed; write <code>{&quot; &quot;}</code> where a space matters.",
  'Sätteri is the default Markdown processor; remark/rehype plugins need <code>unified()</code> as <code>markdown.processor</code>.',
  '<code>src/fetch.ts</code> is reserved for Astro. No <code>@astrojs/db</code>.',
  '<code>ClientRouter</code>, never <code>ViewTransitions</code>; <code>z</code> from <code>astro/zod</code>.',
  'Tailwind 4 is configured in CSS (<code>@theme</code> in <code>globals.css</code>); there is no <code>tailwind.config</code>.',
];

const migrations = [
  {
    title: 'Brand, URL and navigation → site config',
    before: `// hardcoded in Header.astro, Footer.astro, SEO.astro
const navItems = [{ href: '/', label: 'Home' }, ...];`,
    after: `// src/config/site.ts
export const site: SiteConfig = { name, url: SITE_URL,
  titleTemplate: '%s | Brand', nav: [...], footer: {...} };`,
  },
  {
    title: 'Hero badge',
    before: `<Hero badge="true" ... />   <!-- fixed version text -->`,
    after: `<Hero badge={{ label: 'New: online booking', href: '/news' }} ... />`,
  },
  {
    title: 'LogoCloud',
    before: `<LogoCloud />   <!-- built-in logos -->`,
    after: `<LogoCloud title="Built with:" logos={[
  { name: 'Astro', src: '/icons/tech/astro.svg', href: 'https://astro.build' },
]} />`,
  },
  {
    title: 'AIFeature → IntegrationGrid',
    before: `<AIFeature />`,
    after: `<IntegrationGrid title="Works with your tools" items={[
  { name: 'GitHub', href: 'https://github.com', icon: 'code' },
]} />`,
  },
  {
    title: 'Contact form',
    before: `<Contact email="..." />   <!-- always a form, no real endpoint -->`,
    after: `<Contact email="..."
  form={{ action: 'https://your-form-backend.example/submit' }} />
<!-- omit form for contact details only -->`,
  },
  {
    title: 'Newsletter',
    before: `<Newsletter title="..." />   <!-- no real endpoint -->`,
    after: `<Newsletter action="https://your-provider.example/subscribe" title="..." />`,
  },
  {
    title: 'ContentBlock image',
    before: `<ContentBlock title="..." description="..." />
<!-- always showed an empty image box -->`,
    after: `<ContentBlock title="..." description="..."
  image={{ src: photo, alt: 'What the photo shows' }} />
<!-- without image: one text column -->`,
  },
  {
    title: 'AI files and commands → skills',
    before: `.cursorrules, .windsurfrules, .cursor/rules
/new-page, /new-section, /theme, /audit, /launch-check, /plenum
npm run check:kpis`,
    after: `AGENTS.md + .agents/skills/ (.claude/skills/ is generated)
astrodeck-new-page, -new-section, -theme, vibe2prod,
astrodeck-reviewer (Claude Code)
npm run verify`,
  },
];

const structure = [
  { path: 'AGENTS.md', what: 'Index for every coding agent: rules, commands, task → skill' },
  { path: 'PROJECT.md', what: 'Your site brief; overrides AGENTS.md' },
  { path: 'brief/', what: 'Your input material' },
  { path: '.agents/skills/', what: 'Skills (source); .claude/skills/ is a generated mirror' },
  { path: 'src/config/site.ts', what: 'Brand, navigation, footer, SEO defaults, feature flags' },
  { path: 'src/styles/globals.css', what: 'Fonts and design tokens (@theme + .dark)' },
  { path: 'src/registry.json', what: 'Catalog of sections, layouts and UI components' },
  { path: 'src/components/sections/', what: 'Page sections' },
  { path: 'src/components/ui/', what: 'shadcn/ui React primitives' },
  { path: 'src/layouts/', what: 'Base, FullWidth, Minimal, Auth, Article layouts' },
  { path: 'src/pages/', what: 'File-based routes' },
  { path: 'src/content/blog/', what: 'Blog posts (content collection)' },
  { path: 'scripts/, tests/', what: 'Verify, theme, cleanup and sync scripts with tests' },
  { path: 'docs/agents/', what: 'Supported agents and MCP setup' },
];
---

<style>
  .nav-link:not(.bg-foreground):hover {
    background-color: var(--color-muted);
  }
  .nav-link.bg-foreground:hover {
    opacity: 0.9;
  }
</style>

<FullWidthLayout
  title="Documentation"
  description="AstroDeck 4.0 docs: getting started with a coding agent, the build-site workflow, brief, site config, theme, cleanup, verify, vibe2prod, supported agents and migrating from 3.x."
>
  <!-- Header -->
  <div class="py-16 px-6 md:px-12">
    <h1 class="text-4xl font-bold tracking-tight md:text-6xl mb-4">Documentation</h1>
    <p class="text-lg text-muted-foreground max-w-3xl">
      Open AstroDeck in your coding agent and describe your site; the agent follows the workflow
      below. Everything it runs, you can run yourself.
    </p>
  </div>

  <!-- Mobile Sub-Navigation -->
  <div
    class="sticky top-14 z-30 lg:hidden border-b border-t bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60 px-6 md:px-12"
  >
    <button
      id="mobile-subnav-toggle"
      class="flex items-center justify-between w-full py-3 text-sm"
      aria-expanded="false"
      aria-controls="mobile-subnav-menu"
    >
      <span class="flex items-center gap-2 text-muted-foreground">
        <span>On this page:</span>
        <span id="mobile-subnav-current" class="font-medium text-foreground">Getting Started</span>
      </span>
      <svg
        id="mobile-subnav-chevron"
        class="h-4 w-4 text-muted-foreground transition-transform duration-200"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
      </svg>
    </button>
    <nav id="mobile-subnav-menu" class="hidden pb-3 space-y-1" aria-label="Page navigation">
      {
        sections.map((section) => (
          <a
            href={`#${section.id}`}
            data-section={section.id}
            class="nav-link block px-3 py-2.5 text-sm rounded-xl transition-colors"
          >
            {section.label}
          </a>
        ))
      }
    </nav>
  </div>

  <!-- Main Content with Sidebar -->
  <div class="lg:flex lg:gap-10 py-12 px-6 md:px-12">
    <!-- Sticky Sidebar Navigation (Desktop) -->
    <aside class="hidden lg:block lg:w-48 lg:shrink-0">
      <div class="sticky top-20">
        <nav id="docs-nav" class="space-y-1" aria-label="Documentation sections">
          <p class="text-sm font-semibold mb-4 text-muted-foreground" aria-hidden="true">Guide</p>
          {
            sections.map((section) => (
              <a
                href={`#${section.id}`}
                data-section={section.id}
                class="nav-link block px-3 py-2.5 text-sm rounded-xl transition-colors"
              >
                {section.label}
              </a>
            ))
          }
        </nav>
      </div>
    </aside>

    <!-- Docs Content -->
    <div class="flex-1 min-w-0 space-y-20">
      <!-- Getting Started -->
      <section id="getting-started" class="scroll-mt-32 lg:scroll-mt-20">
        <div class="mb-8">
          <h2 class="text-3xl font-bold mb-2">Getting Started</h2>
          <p class="text-muted-foreground">
            Download AstroDeck, open it in your coding agent and describe your site. Requires
            Node.js <code class={ic}>&gt;=22.23.4</code>.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class={card}>
            <h3 class="font-semibold mb-3">No coding experience</h3>
            <ol class="list-decimal pl-5 space-y-2 text-sm text-muted-foreground">
              <li>
                Download the ZIP from the{' '}
                <a
                  class={link}
                  href="https://github.com/holger1411/astrodeck/releases/latest"
                  target="_blank"
                  rel="noopener noreferrer">latest release</a
                > and unzip it.
              </li>
              <li>
                Optional: put what you already have into the <code class={ic}>brief/</code> folder (texts,
                PDFs, a logo, a <code class={ic}>DESIGN.md</code>).
              </li>
              <li>
                Open the folder in your coding agent (Claude Code, Codex, Cursor, GitHub Copilot,
                Gemini CLI, Windsurf) and say what you want:
              </li>
            </ol>
            <div class="bg-muted/50 border border-border rounded-xl p-4 mt-4">
              <p class="text-sm italic">
                "Build my website for a physiotherapy practice in Hamburg with online booking."
              </p>
            </div>
            <p class="text-sm text-muted-foreground mt-3">
              The agent installs everything, asks a few questions in one message (each with a
              proposed default), shows a preview at <code class={ic}>http://localhost:4321</code>
              and iterates with you. You do not need to run any command yourself.
            </p>
          </div>
          <div class={card}>
            <h3 class="font-semibold mb-3">Developers</h3>
            <pre
              class={pre}><code class="text-sm font-mono">{`npx degit holger1411/astrodeck my-site
cd my-site
npm install
npm run dev`}</code></pre>
            <p class="text-sm text-muted-foreground mt-3">
              <code class={ic}>git clone</code> or the release ZIP work the same way. Then let your agent
              run the workflow, or work by hand: set <code class={ic}>src/config/site.ts</code>, run <code
                class={ic}>npm run theme</code
              >, compose pages from sections and finish with <code class={ic}>npm run verify</code>.
            </p>
            <p class="text-sm text-muted-foreground mt-3">
              Avoid <code class={ic}>npm create astro -- --template holger1411/astrodeck</code>:
              create-astro can write its own <code class={ic}>AGENTS.md</code> over the kit's.
            </p>
          </div>
        </div>
      </section>

      <!-- Build-site workflow -->
      <section id="workflow" class="scroll-mt-32 lg:scroll-mt-20">
        <div class="mb-8">
          <h2 class="text-3xl font-bold mb-2">The Build-Site Workflow</h2>
          <p class="text-muted-foreground">
            "Build my website" routes the agent to the <code class={ic}>astrodeck-build-site</code> skill
            (<code class={ic}>.agents/skills/astrodeck-build-site/SKILL.md</code>). It works through
            eight steps and names the command and reference for each.
          </p>
        </div>
        <ol class="space-y-4">
          {
            workflow.map((step, i) => (
              <li class={`${card} flex gap-4`}>
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary text-primary-foreground text-sm font-semibold">
                  {i + 1}
                </span>
                <div>
                  <h3 class="font-semibold">{step.title}</h3>
                  <p class="text-sm text-muted-foreground mt-1">{step.text}</p>
                  {step.cmd && (
                    <p class="mt-2">
                      <code class={ic}>{step.cmd}</code>
                    </p>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
        <div class={`${card} mt-8 overflow-x-auto`}>
          <h3 class="font-semibold mb-3">Task → skill</h3>
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b text-left">
                <th class="pb-2 pr-4 font-medium text-muted-foreground">The user wants ...</th>
                <th class="pb-2 font-medium text-muted-foreground">Skill</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              {
                skillRoutes.map((r) => (
                  <tr>
                    <td class="py-2 pr-4">{r.task}</td>
                    <td class="py-2 font-mono text-xs">{r.skill}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          <p class="text-sm text-muted-foreground mt-3">
            Skills live in <code class={ic}>.agents/skills/</code> ({kitStats.skills} skills: {
              skills.join(', ')
            }). <code class={ic}>AGENTS.md</code> names every one, so agents that do not load skills on
            their own still find them.
          </p>
        </div>
      </section>

      <!-- Brief -->
      <section id="brief" class="scroll-mt-32 lg:scroll-mt-20">
        <div class="mb-8">
          <h2 class="text-3xl font-bold mb-2">Brief Folder &amp; PROJECT.md</h2>
          <p class="text-muted-foreground">
            Your input can be one sentence or a full briefing. More material means fewer questions.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class={card}>
            <h3 class="font-semibold mb-3"><code class={ic}>brief/</code> — your material</h3>
            <ul class="space-y-2 text-sm text-muted-foreground list-disc pl-5">
              <li>Texts: about, services, company profile PDF, an old flyer</li>
              <li>Page content: opening hours, prices, FAQs, quotes you may use</li>
              <li>
                Design: a <code class={ic}>DESIGN.md</code> with color tokens, brand guidelines, logo
                files (SVG preferred)
              </li>
              <li>Images you own, and a links list (current site, profiles, sites you like)</li>
            </ul>
            <p class="text-sm text-muted-foreground mt-3">
              Files in <code class={ic}>brief/</code> are inputs, not part of the website. No passwords
              or keys: in a public repository this folder is public too.
            </p>
          </div>
          <div class={card}>
            <h3 class="font-semibold mb-3"><code class={ic}>PROJECT.md</code> — the brief</h3>
            <p class="text-sm text-muted-foreground mb-3">
              The agent writes a structured brief and keeps it up to date. It overrides the defaults
              in <code class={ic}>AGENTS.md</code>, so later sessions and other agents continue from
              it. Headings:
            </p>
            <p class="text-sm">
              Goal &amp; audience · Offer · Sitemap · Tone &amp; language · Brand · Content sources
              · Must-haves / no-gos · Open questions · Decisions &amp; defaults
            </p>
            <p class="text-sm text-muted-foreground mt-3">
              Only real facts go in. Missing facts become open questions and stay off the site.
            </p>
          </div>
        </div>
      </section>

      <!-- Site config -->
      <section id="site-config" class="scroll-mt-32 lg:scroll-mt-20">
        <div class="mb-8">
          <h2 class="text-3xl font-bold mb-2">Site Config</h2>
          <p class="text-muted-foreground">
            Brand, navigation, footer, SEO defaults and feature flags live in one typed file: <code
              class={ic}>src/config/site.ts</code
            >. The production URL lives in <code class={ic}>src/config/site-url.mjs</code>
            (<code class={ic}>SITE_URL</code>), shared with <code class={ic}>astro.config.mjs</code
            >.
          </p>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div class={`${card} overflow-x-auto`}>
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b text-left">
                  <th class="pb-2 pr-4 font-medium text-muted-foreground">Field</th>
                  <th class="pb-2 font-medium text-muted-foreground">Used for</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                {
                  configFields.map((f) => (
                    <tr>
                      <td class="py-2 pr-4 font-mono text-xs whitespace-nowrap">{f.field}</td>
                      <td class="py-2 text-muted-foreground">{f.use}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <div class={card}>
            <pre
              class={pre}><code class="text-sm font-mono">{`export const site: SiteConfig = {
  name: 'Harbor Physio',
  url: SITE_URL,
  description: 'Physiotherapy in Hamburg-Altona',
  lang: 'en',
  locale: 'en_US',
  titleTemplate: '%s | Harbor Physio',
  nav: [
    { href: '/', label: 'Home' },
    { href: '/services', label: 'Services' },
  ],
  // footer, social, contact, ogImage, features ...
};`}</code></pre>
            <p class="text-sm text-muted-foreground mt-3">
              Pages pass plain titles (<code class={ic}>title="Services"</code>); the layout adds
              the brand through <code class={ic}>titleTemplate</code>. Components never repeat the
              brand name.
            </p>
          </div>
        </div>
      </section>

      <!-- Theme -->
      <section id="theme" class="scroll-mt-32 lg:scroll-mt-20">
        <div class="mb-8">
          <h2 class="text-3xl font-bold mb-2">Theme &amp; Branding</h2>
          <p class="text-muted-foreground">
            <code class={ic}>npm run theme</code> writes OKLCH color tokens for light and dark mode into
            <code class={ic}>src/styles/globals.css</code> and checks WCAG contrast of the key text pairs.
            It fails when a pair is too weak and suggests the nearest passing value.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class={card}>
            <h3 class="font-semibold mb-3">With your agent</h3>
            <div class="bg-muted/50 border border-border rounded-xl p-4">
              <p class="text-sm italic">"Use our brand color #0f766e and rounder corners."</p>
            </div>
            <div class="bg-muted/50 border border-border rounded-xl p-4 mt-3">
              <p class="text-sm italic">"Apply brief/DESIGN.md."</p>
            </div>
            <p class="text-sm text-muted-foreground mt-3">
