---
/**
 * Minimal Layout
 *
 * Full-width layout without header or footer.
 * Ideal for standalone pages like 404, maintenance, or landing pages
 * that need complete control over the viewport.
 *
 * @example
 * ```astro
 * <MinimalLayout title="Page Not Found">
 *   <div class="flex items-center justify-center min-h-screen">
 *     <h1>404</h1>
 *   </div>
 * </MinimalLayout>
 * ```
 */
import '@/styles/globals.css';
import Head from '@/components/Head.astro';
import { site } from '@/config/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description = site.description, image, noindex = false } = Astro.props;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <Head title={title} description={description} image={image} noindex={noindex} />
  </head>
  <body class="min-h-screen antialiased">
    <main id="main-content" class="min-h-screen">
      <slot />
    </main>
  </body>
</html>
