---
/**
 * Auth Layout
 *
 * Minimal layout for authentication pages (login, signup, password reset).
 * No header/footer, includes SEO with noindex for auth pages.
 */
import '@/styles/globals.css';
import Head from '@/components/Head.astro';
import Logo from '@/components/Logo.astro';
import { site } from '@/config/site';

interface Props {
  title: string;
  description?: string;
  /** Optional quote shown in the branding panel. Nothing is rendered when omitted. */
  testimonial?: { quote: string; author: string; role?: string };
}

const { title, description = `Sign in to your ${site.name} account`, testimonial } = Astro.props;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <Head title={title} description={description} noindex={true} />
  </head>
  <body class="min-h-screen antialiased">
    <div
      class="container relative min-h-screen flex-col items-center justify-center grid lg:max-w-none lg:grid-cols-2 lg:px-0"
    >
      <div
        class="relative hidden h-full flex-col bg-muted p-10 text-primary-foreground lg:flex dark:border-r"
      >
        <div class="absolute inset-0 bg-primary"></div>
        <div class="relative z-20 flex items-center text-lg font-medium">
          <Logo />
        </div>
        {
          testimonial && (
            <div class="relative z-20 mt-auto">
              <blockquote class="space-y-2">
                <p class="text-lg">&ldquo;{testimonial.quote}&rdquo;</p>
                <footer class="text-sm">
                  {testimonial.author}
                  {testimonial.role && `, ${testimonial.role}`}
                </footer>
              </blockquote>
            </div>
          )
        }
      </div>
      <main id="main-content" class="lg:p-8">
        <div class="mx-auto flex w-full flex-col justify-center space-y-6 sm:w-[350px]">
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
