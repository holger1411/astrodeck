---
/**
 * Full Width Layout
 *
 * Layout for showcase pages, portfolios, and galleries that need
 * full viewport width. Includes SEO meta tags.
 */
import '@/styles/globals.css';
import Head from '@/components/Head.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import AnimationObserver from '@/components/AnimationObserver.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Exclude the page from search engines (adds robots noindex, nofollow) */
  noindex?: boolean;
}

const {
  title,
  description = 'AstroDeck - Modern Astro.js Component Library',
  image,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={title} description={description} image={image} noindex={noindex} />
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 bg-primary text-primary-foreground px-4 py-2 rounded-md font-medium"
    >
      Skip to content
    </a>
    <Header variant="fullWidth" />
    <main id="main-content" class="flex-1 w-full">
      <slot />
    </main>
    <Footer variant="fullWidth" />
    <AnimationObserver />
  </body>
</html>
