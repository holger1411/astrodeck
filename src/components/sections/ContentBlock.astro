---
/**
 * Text block (tagline, h2, description, optional bullet list) with an optional image.
 * With `image` it renders two columns (image left or right); without, a single text column.
 * `image.src` accepts an imported image (optimized via astro:assets) or a URL / public path.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  tagline?: string;
  title: string;
  description: string;
  features?: string[];
  image?: { src: ImageMetadata | string; alt: string };
  imageSide?: 'left' | 'right';
}

const { tagline, title, description, features, image, imageSide = 'right' } = Astro.props;
const imageLeft = !!image && imageSide === 'left';
---

<section class="py-16 md:py-24 px-6">
  <div class="container max-w-5xl mx-auto">
    <div
      class:list={[
        image ? 'grid gap-12 lg:grid-cols-2 lg:gap-16 items-center' : 'max-w-3xl',
        imageLeft && 'lg:grid-flow-dense',
      ]}
    >
      <div class:list={['space-y-6', imageLeft && 'lg:col-start-2']}>
        {
          tagline && (
            <p class="text-sm font-semibold text-primary uppercase tracking-wide">{tagline}</p>
          )
        }
        <h2 class="text-3xl font-bold leading-[1.1] sm:text-3xl md:text-4xl">
          {title}
        </h2>
        <p class="text-lg text-muted-foreground leading-relaxed">
          {description}
        </p>
        {
          features && features.length > 0 && (
            <ul class="space-y-3 pt-2">
              {features.map((feature) => (
                <li class="flex items-start gap-3">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-5 w-5 text-primary mt-0.5 flex-shrink-0"
                  >
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                  <span class="text-muted-foreground">{feature}</span>
                </li>
              ))}
            </ul>
          )
        }
      </div>
      {
        image && (
          <div class:list={['overflow-hidden rounded-lg', imageLeft && 'lg:col-start-1']}>
            {typeof image.src === 'string' ? (
              <img
                src={image.src}
                alt={image.alt}
                width="800"
                height="600"
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] w-full object-cover"
              />
            ) : (
              <Image
                src={image.src}
                alt={image.alt}
                widths={[480, 800, 1200]}
                sizes="(min-width: 1024px) 480px, 100vw"
                class="aspect-[4/3] w-full object-cover"
              />
            )}
          </div>
        )
      }
    </div>
  </div>
</section>
