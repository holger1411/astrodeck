---
/**
 * LogoCloud Section Component
 *
 * A single row of logos with a leading label. Each logo is either an image (`src`),
 * a built-in icon (`icon`), or just a name. Add `href` to make it a link.
 *
 * Only use logos you have the right to show (your own stack, real customers with permission).
 *
 * @example
 * ```astro
 * <LogoCloud
 *   title="Built with:"
 *   logos={[
 *     { name: 'Astro', src: '/icons/tech/astro.svg', href: 'https://astro.build' },
 *     { name: 'Fast', icon: 'zap' },
 *   ]}
 * />
 * ```
 *
 * @customization
 * - Image logos should be single-colour SVGs (black fill); they are inverted in dark mode
 * - Add icons in `src/lib/icons.ts`
 */
import { icons, type IconName } from '@/lib/icons';

interface Logo {
  name: string;
  /** Image URL (single-colour SVG recommended) */
  src?: string;
  /** Built-in icon, used when no `src` is given */
  icon?: IconName;
  href?: string;
}

interface Props {
  title?: string;
  logos: Logo[];
}

const { title, logos } = Astro.props;
---

<section class="py-12 border-y">
  <div class="container max-w-5xl mx-auto px-6">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
      {
        title && (
          <span class="text-sm text-muted-foreground font-medium whitespace-nowrap">{title}</span>
        )
      }
      <ul
        class="grid grid-cols-2 sm:grid-cols-3 lg:flex lg:flex-1 lg:justify-between lg:items-center gap-x-6 gap-y-4 lg:gap-x-4"
      >
        {
          logos.map((logo) => {
            const Tag = logo.href ? 'a' : 'div';
            return (
              <li>
                <Tag
                  href={logo.href}
                  class:list={[
                    'flex items-center gap-1.5 text-foreground',
                    logo.href && 'hover:text-primary transition-colors',
                  ]}
                >
                  {logo.src ? (
                    <img
                      src={logo.src}
                      alt=""
                      width="20"
                      height="20"
                      class="h-5 w-5 dark:invert"
                      loading="lazy"
                    />
                  ) : (
                    logo.icon && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-5 w-5"
                        aria-hidden="true"
                      >
                        <path d={icons[logo.icon]} />
                      </svg>
                    )
                  )}
                  <span class="font-medium text-sm">{logo.name}</span>
                </Tag>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>
