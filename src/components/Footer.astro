---
/**
 * Footer Component
 *
 * Unified footer with boxed and fullWidth variants.
 * Contains navigation links, resources, and creator info.
 *
 * @example
 * ```astro
 * <Footer />
 * <Footer variant="fullWidth" />
 * ```
 */
import Logo from './Logo.astro';
import { site } from '@/config/site';
import { ui } from '@/config/ui';

interface Props {
  /** Layout variant - boxed (default) or fullWidth */
  variant?: 'boxed' | 'fullWidth';
}

const { variant = 'boxed' } = Astro.props;

const { groups, tagline, copyright, credit } = site.footer;
const { email, phone, address } = site.contact;
const hasContact = Boolean(email || phone || address);
// tel: URIs must not contain spaces; keep digits and a leading +.
const telHref = phone ? `tel:${phone.replace(/[^\d+]/g, '')}` : undefined;
const isExternal = (href: string) => /^https?:\/\//i.test(href);
const linkClass =
  'inline-block py-1 text-sm text-muted-foreground hover:text-foreground transition-colors';

const containerClass =
  variant === 'fullWidth' ? 'w-full px-4' : 'container max-w-5xl mx-auto px-4 sm:px-6';
---

<footer class="border-t bg-background">
  <div class:list={[containerClass, 'py-12']}>
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <Logo />
        {tagline && <p class="mt-4 text-sm text-muted-foreground">{tagline}</p>}
        {
          hasContact && (
            <ul class="mt-4" aria-label={ui.contact.list}>
              {email && (
                <li>
                  <span class="sr-only">{ui.contact.email}: </span>
                  <a href={`mailto:${email}`} class={linkClass}>
                    {email}
                  </a>
                </li>
              )}
              {phone && (
                <li>
                  <span class="sr-only">{ui.contact.phone}: </span>
                  <a href={telHref} class={linkClass}>
                    {phone}
                  </a>
                </li>
              )}
              {address && (
                <li class="py-1 text-sm text-muted-foreground whitespace-pre-line">
                  <span class="sr-only">{ui.contact.address}: </span>
                  {address}
                </li>
              )}
            </ul>
          )
        }
        {
          site.social.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-x-4" aria-label={ui.footer.social}>
              {site.social.map((profile) => (
                <li>
                  <a
                    href={profile.href}
                    class={linkClass}
                    {...(isExternal(profile.href)
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {})}
                  >
                    {profile.label}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        groups.map((group) => (
          <div>
            <h3 class="font-semibold mb-4">{group.title}</h3>
            <ul class="space-y-0">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="inline-block py-1 text-sm text-muted-foreground hover:text-foreground transition-colors"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <!-- Creator (only when site.footer.credit is set) -->
      {
        credit && (
          <div class="col-span-2 md:col-span-1">
            <h3 class="font-semibold mb-4">{ui.footer.creditHeading}</h3>
            <p class="text-sm text-muted-foreground">
              {ui.footer.createdBy} {site.author}
            </p>
            <p class="text-sm text-muted-foreground mt-1">
              {ui.footer.createdFor}{' '}
              <a
                href={credit.href}
                class="font-medium text-foreground hover:text-primary transition-colors inline-flex items-center gap-1 py-1"
                target="_blank"
                rel="noopener noreferrer"
              >
                {credit.label}
                <svg
                  class="h-3 w-3"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                  />
                </svg>
              </a>
            </p>
          </div>
        )
      }
    </div>

    <!-- Copyright -->
    <div class="mt-8 border-t pt-8 text-center text-sm text-muted-foreground">
      <p>&copy; {new Date().getFullYear()} {copyright}</p>
    </div>
  </div>
</footer>
