---
/**
 * Logo Component
 *
 * Site logo from `site.logo` in src/config/site.ts: an inline SVG mark (`svg`, uses
 * currentColor so it follows dark mode) or an image file (`src`), plus the wordmark (`text`).
 * Without `svg` and `src` it renders the wordmark only.
 * Used consistently across Header, Footer, 404 and Auth layouts.
 *
 * @example
 * ```astro
 * <Logo />
 * <Logo showText={false} />
 * <Logo size="lg" />
 * ```
 */
import { site } from '@/config/site';

interface Props {
  /** Show the wordmark (site.logo.text) next to the mark */
  showText?: boolean;
  /** Size variant */
  size?: 'sm' | 'md' | 'lg';
  /** Additional CSS classes */
  class?: string;
}

const { showText = true, size = 'md', class: className = '' } = Astro.props;
const { logo, name } = site;

const sizeClasses = {
  sm: 'h-5',
  md: 'h-6',
  lg: 'h-8',
};

const textSizeClasses = {
  sm: 'text-sm',
  md: 'text-base',
  lg: 'text-lg',
};

const label = logo.alt ?? name;
const withText = showText && logo.text.trim() !== '';
---

<a
  href="/"
  class:list={['flex items-center gap-2', className]}
  aria-label={withText ? undefined : label}
>
  {
    logo.svg ? (
      <span
        class:list={['inline-flex aspect-square [&>svg]:h-full [&>svg]:w-full', sizeClasses[size]]}
        aria-hidden="true"
        set:html={logo.svg}
      />
    ) : (
      logo.src && (
        <img
          src={logo.src}
          alt={withText ? '' : label}
          class:list={['w-auto', sizeClasses[size]]}
        />
      )
    )
  }
  {withText && <span class:list={['font-bold', textSizeClasses[size]]}>{logo.text}</span>}
</a>
