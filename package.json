{
  "name": "astrodeck",
  "type": "module",
  "version": "3.5.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node -e \"require('node:fs').copyFileSync('dist/sitemap-index.xml','dist/sitemap.xml')\"",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:docs": "node scripts/lint-docs.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "lint:design": "node scripts/lint-design.mjs",
    "theme": "node scripts/theme.mjs",
    "icons": "node scripts/icons.mjs",
    "check:registry": "node scripts/check-registry.mjs",
    "starter:clean": "node scripts/starter-clean.mjs",
    "sync:agents": "node scripts/sync-agents.mjs",
    "sync:vibe2prod": "node scripts/sync-vibe2prod.mjs",
    "setup:audit": "node scripts/setup-audit.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "verify": "node scripts/verify.mjs",
    "validate": "node scripts/verify.mjs --skip-build"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.4",
    "@vercel/analytics": "^1.6.1",
    "astro": "^7.4.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "markdown-it": "^15.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "^2.17.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.39.2",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sanitize-html": "^2.16.1",
    "culori": "^4.0.2",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "globals": "^17.6.0",
    "node-html-parser": "^9.0.7",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.5"
    }
  }
}
